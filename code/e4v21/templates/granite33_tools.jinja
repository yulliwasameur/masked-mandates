{#- Chat template for ibm-granite/granite-3.3-8b-instruct with OpenAI-style tool calling (E4 v2).
    Derived from the model's own template (tokenizer_config.json) and from vLLM's examples/tool_chat_template_granite.jinja:
    (1) when tools are given, the model's official tool instruction is appended to a caller-supplied system message
        (the official template only adds it to its default system message);
    (2) assistant turns that carry tool calls are rendered as <|tool_call|>[{"name": ..., "arguments": {...}}]
        (the official template drops them from the history);
    (3) tool results are rendered with the role tool_response. -#}
{%- set tool_instruction = " You are a helpful assistant with access to the following tools. When a tool is required to answer the user's query, respond only with <|tool_call|> followed by a JSON list of tools used. If a tool does not exist in the provided list of tools, notify the user that you do not have the ability to fulfill the request." -%}
{%- if messages[0]['role'] == 'system' %}
    {%- set system_message = messages[0]['content'] %}
    {%- set loop_messages = messages[1:] %}
{%- else %}
    {%- set system_message = "Knowledge Cutoff Date: April 2024.\nYou are Granite, developed by IBM." %}
    {%- set loop_messages = messages %}
{%- endif %}
{%- if tools %}{%- set system_message = system_message + tool_instruction %}{%- endif %}
{{- '<|start_of_role|>system<|end_of_role|>' + system_message + '<|end_of_text|>\n' }}
{%- if tools %}
    {{- '<|start_of_role|>available_tools<|end_of_role|>' }}
    {{- tools | tojson(indent=4) }}
    {{- '<|end_of_text|>\n' }}
{%- endif %}
{%- for message in loop_messages %}
    {%- if message['role'] == 'assistant' and message.tool_calls is defined and message.tool_calls %}
        {%- set ns = namespace(calls=[]) %}
        {%- for tc in message.tool_calls %}
            {%- set f = tc.function if tc.function is defined else tc %}
            {%- set ns.calls = ns.calls + [{'name': f.name, 'arguments': f.arguments}] %}
        {%- endfor %}
        {{- '<|start_of_role|>assistant<|end_of_role|><|tool_call|>' + ns.calls | tojson + '<|end_of_text|>\n' }}
    {%- elif message['role'] == 'tool' %}
        {{- '<|start_of_role|>tool_response<|end_of_role|>' + message['content'] + '<|end_of_text|>\n' }}
    {%- else %}
        {{- '<|start_of_role|>' + message['role'] + '<|end_of_role|>' + (message['content'] or '') + '<|end_of_text|>\n' }}
    {%- endif %}
    {%- if loop.last and add_generation_prompt %}
        {{- '<|start_of_role|>assistant<|end_of_role|>' }}
    {%- endif %}
{%- endfor %}
